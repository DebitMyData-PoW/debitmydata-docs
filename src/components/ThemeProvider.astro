---
// Light by default, as on the other DebitMyData sites; dark once chosen with the switch.
// This site keeps its own choice (its own storage), so the other sites keep theirs.
---

{/* Inlined so the page never flashes the wrong theme. */}
<script is:inline>
  window.StarlightThemeProvider = (() => {
    let stored = null;
    try {
      stored = localStorage.getItem('starlight-theme');
    } catch {
      stored = null;
    }
    document.documentElement.dataset.theme = stored === 'dark' ? 'dark' : 'light';
    return { updatePickers() {} };
  })();
</script>
