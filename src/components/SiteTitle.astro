---
// The site's name in the top bar: the DebitMyData logo (its dark version in the dark theme), then
// "DebitMyData Docs" with "Docs" in red, as "DebitMyData Stats" on stats.debitmydata.io.
import logo from '../assets/debitmydata-logo.png';
import logoDark from '../assets/debitmydata-logo-dark.png';

const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <img class="light-logo" src={logo.src} width={logo.width} height={logo.height} alt="" />
  <img class="dark-logo" src={logoDark.src} width={logoDark.width} height={logoDark.height} alt="" />
  <span translate="no">DebitMyData <span class="red">Docs</span></span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    color: var(--sl-color-white);
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .site-title:hover {
    color: var(--sl-color-white);
  }
  img {
    height: 2.5rem;
    width: auto;
    flex: none;
  }
  .dark-logo,
  :global([data-theme='dark']) .light-logo {
    display: none;
  }
  :global([data-theme='dark']) .dark-logo {
    display: block;
  }
  span {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .red {
    color: var(--dmd-red-text);
  }
  @media (max-width: 30rem) {
    .site-title {
      font-size: 1.1rem;
      gap: 0.45rem;
    }
    img {
      height: 2.1rem;
    }
  }
</style>
